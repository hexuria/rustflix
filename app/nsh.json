{
  "name": "rustflix",
  "id": "com.hexuria.rustflix",
  "version": "0.1.0",
  "build": 1,
  "appearance": "dark",
  "capabilities": {
    "network": {
      "hosts": [
        "api.themoviedb.org",
        "*.themoviedb.org",
        "*.tmdb.org",
        "api.anilist.co",
        "graphql.anilist.co",
        "api.aniskip.com",
        "hianime.at",
        "*.hianime.at"
      ]
    },
    "webview": {
      "hosts": ["*"]
    },
    "openUrl": {
      "schemes": ["https"]
    },
    "process": {
      "execute": ["/bin/sh", "cmd.exe", "python3", "/usr/bin/python3", "python"]
    }
  }
}
